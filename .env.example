# Save populated values privately as .secrets/fri.env (mode 0600).
DISCORD_TOKEN=
# Dedicated Fri service credential: same value as the controller's GENE_FRI_TOKEN.
GENE_FRI_TOKEN=
# Compatibility names intentionally preserve existing identity and scope.
GENE_GUILD_ID=
GENE_OWNER_ID=
GENE_WORKSHOP_CHANNEL_ID=
GENE_CONTROLLER_URL=http://controller:8787
FRI_PRESENCE=invisible
FRI_DATA=/data
FRI_CHATGPT_AUTH=/auth/session.json
# Immutable release identity is supplied by the coordinator, not this file.
