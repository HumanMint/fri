# Fri's settings. Copy them to a private, git-ignored file and fill in the blanks:
#   a local trial: scripts/local.sh setup writes .env.local (docs/quickstart.md);
#   a server install: .secrets/fri.env, mode 0600 (docs/operations.md).
# Fri's own bot token (Developer Portal > your application > Bot). Never commit or paste it.
DISCORD_TOKEN=
# Dedicated Fri service credential: same value as the controller's GENE_FRI_TOKEN.
GENE_FRI_TOKEN=
# Discord IDs: the server, Fri's owner and the channel Fri always answers in. They must match
# the controller's values. Compatibility names intentionally preserve existing identity and scope.
GENE_GUILD_ID=
GENE_OWNER_ID=
GENE_WORKSHOP_CHANNEL_ID=
# Inside Docker's network; a controller on the same machine is http://127.0.0.1:8787.
GENE_CONTROLLER_URL=http://controller:8787
FRI_PRESENCE=invisible
# Container paths. A local trial uses paths inside the checkout instead.
FRI_DATA=/data
FRI_CHATGPT_AUTH=/auth/session.json
# Immutable release identity is supplied by the coordinator, not this file.
